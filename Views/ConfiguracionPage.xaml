<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DebtMessageManager.ViewModels"
             xmlns:models="clr-namespace:DebtMessageManager.Models"
             x:Class="DebtMessageManager.Views.ConfiguracionPage"
             x:DataType="viewmodels:ConfiguracionViewModel"
             Title="Configuración"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Sección Parámetros Generales -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="⚙️ PARÁMETROS GENERALES DE AUTOMATIZACIÓN" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" />

                    <!-- Switch Automatización Activa -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Automatización Activa" FontSize="14" FontAttributes="Bold" TextColor="#334155" />
                            <Label Text="Permitir evaluación y envíos periódicos" FontSize="12" TextColor="#64748B" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AutomatizacionActiva}" OnColor="#2563EB" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <!-- Horario de Envío -->
                    <Label Text="Ventana Horaria de Envíos Permitida:" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Hora Inicio (Ej. 08:00)" FontSize="11" TextColor="#64748B" />
                            <TimePicker Time="{Binding HoraInicio}" Format="HH:mm" BackgroundColor="#F8FAFC" HeightRequest="40" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Hora Fin (Ej. 18:00)" FontSize="11" TextColor="#64748B" />
                            <TimePicker Time="{Binding HoraFin}" Format="HH:mm" BackgroundColor="#F8FAFC" HeightRequest="40" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <!-- Días de Gracia -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Días de Gracia" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                            <Label Text="Días de espera tras vencimiento antes de enviar mora" FontSize="11" TextColor="#64748B" />
                        </VerticalStackLayout>
                        <Entry Grid.Column="1" Text="{Binding DiasGracia}" Keyboard="Numeric" WidthRequest="60" HeightRequest="40" HorizontalTextAlignment="Center" BackgroundColor="#F8FAFC" />
                    </Grid>

                    <Button Text="💾 Guardar Parámetros" Command="{Binding GuardarConfiguracionCommand}" BackgroundColor="#2563EB" TextColor="White" CornerRadius="8" HeightRequest="42" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Sección Reglas de Envío -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="📋 REGLAS DE ENVÍO Y RECORDATORIOS" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" />
                    <Label Text="Activa o desactiva las frecuencias de contacto:" FontSize="12" TextColor="#64748B" />

                    <CollectionView ItemsSource="{Binding Reglas}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReglaEnvio">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Nombre}" FontSize="13" FontAttributes="Bold" TextColor="#1E293B" />
                                        <Label Text="{Binding DescripcionRegla}" FontSize="11" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" 
                                            IsToggled="{Binding Activa}" 
                                            OnColor="#059669" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Sección Plantillas de Mensaje -->
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✍️ EDITOR DE PLANTILLAS SMS" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" />

                    <!-- Selector de Plantilla existente -->
                    <Label Text="Plantillas disponibles:" FontSize="12" TextColor="#64748B" />
                    <CollectionView ItemsSource="{Binding Plantillas}" HeightRequest="80">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlantillaMensaje">
                                <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 6" Stroke="#E2E8F0" Padding="8,4" Margin="0,2">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ConfiguracionViewModel}}, Path=SeleccionarPlantillaCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Nombre}" FontSize="12" FontAttributes="Bold" TextColor="#1E293B" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Entry Placeholder="Nombre de la plantilla" Text="{Binding PlantillaNombre}" BackgroundColor="#F8FAFC" HeightRequest="40" />

                    <!-- Botones para insertar variables -->
                    <Label Text="Insertar Variables Disponibles:" FontSize="11" FontAttributes="Bold" TextColor="#475569" />
                    <HorizontalStackLayout Spacing="6">
                        <Button Text="{}{NOMBRE}" Command="{Binding InsertarVariableCommand}" CommandParameter="{}{NOMBRE}" BackgroundColor="#E0E7FF" TextColor="#3730A3" FontSize="10" HeightRequest="30" Padding="6,0" CornerRadius="6" />
                        <Button Text="{}{MONTO}" Command="{Binding InsertarVariableCommand}" CommandParameter="{}{MONTO}" BackgroundColor="#E0E7FF" TextColor="#3730A3" FontSize="10" HeightRequest="30" Padding="6,0" CornerRadius="6" />
                        <Button Text="{}{FECHA_VENCIMIENTO}" Command="{Binding InsertarVariableCommand}" CommandParameter="{}{FECHA_VENCIMIENTO}" BackgroundColor="#E0E7FF" TextColor="#3730A3" FontSize="10" HeightRequest="30" Padding="6,0" CornerRadius="6" />
                        <Button Text="{}{DIAS_RETRASO}" Command="{Binding InsertarVariableCommand}" CommandParameter="{}{DIAS_RETRASO}" BackgroundColor="#E0E7FF" TextColor="#3730A3" FontSize="10" HeightRequest="30" Padding="6,0" CornerRadius="6" />
                    </HorizontalStackLayout>

                    <Editor Placeholder="Escriba el texto del mensaje..." Text="{Binding PlantillaContenido}" HeightRequest="100" AutoSize="Disabled" BackgroundColor="#F8FAFC" />

                    <!-- Vista Previa en Vivo -->
                    <Label Text="Vista Previa de Ejemplo:" FontSize="11" FontAttributes="Bold" TextColor="#059669" />
                    <Border BackgroundColor="#F0FDF4" StrokeShape="RoundRectangle 8" Stroke="#BBF7D0" Padding="10">
                        <Label Text="{Binding PlantillaVistaPrevia}" FontSize="12" TextColor="#166534" LineBreakMode="WordWrap" />
                    </Border>

                    <Button Text="💾 Guardar Plantilla" Command="{Binding GuardarPlantillaCommand}" BackgroundColor="#059669" TextColor="White" CornerRadius="8" HeightRequest="42" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

